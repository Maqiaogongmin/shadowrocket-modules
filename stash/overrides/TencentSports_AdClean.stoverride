name: 腾讯体育净化
desc: 由 TG@ZenMoFiShi 的 Quantumult X 脚本迁移到 Stash。去除开屏广告、优化我的页面、去除底部会员 Tab、优化首页展示、去除搜索热词。
# Original: https://github.com/ZenmoFeiShi/Qx

http:
  mitm:
    - config.ab.qq.com
    - k.ssp.qq.com
    - app.sports.qq.com
    - sports.ssp.qq.com

  script:
    # GetTabRemoteConfig 返回 protobuf，需要 Stash binary-mode。
    # 原 QX 使用 url-and-header 匹配 User-Agent；这里改为 URL 匹配，
    # UA 判断仍由原脚本自身完成，所以行为保持一致。
    - name: txsports-ad-clean
      match: '^https:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: 2097152
      timeout: 10
      engine: auto

    # 其余接口为 XML / JSON 文本响应。
    - name: txsports-ad-clean
      match: '^https:\/\/(?:k\.ssp\.qq\.com\/getsdkconfig|app\.sports\.qq\.com\/(?:init\/config|user\/homePageV2|m\/match\/liveSum|match\/multiUpdate|feeds\/(?:home|list))|sports\.ssp\.qq\.com\/app)(?:\?.*)?$'
      type: response
      require-body: true
      binary-mode: false
      max-size: 2097152
      timeout: 10
      engine: auto

script-providers:
  txsports-ad-clean:
    url: https://raw.githubusercontent.com/Maqiaogongmin/shadowrocket-modules/main/stash/scripts/txsports-ad-clean.js
    interval: 86400
