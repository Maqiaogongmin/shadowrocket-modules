name: YouTube 去广告
desc: 原 QX YouTube 去广告迁移版。使用 Maasea 脚本；仅针对 YouTube/GoogleVideo 阻断 QUIC，避免 UDP 转发绕过 HTTP 重写。
icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png

rules:
  - 'AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT'
  - 'AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT'

http:
  mitm:
    - '*.googlevideo.com'
    - youtubei.googleapis.com
    - www.youtube.com
    - s.youtube.com

  url-rewrite:
    - '(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302'
    - '^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad - reject-200'
    - '^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200'
    - '^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject-200'
    - '^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject-200'

  script:
    - name: youtube-response-clean
      match: '^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(\?.*)?$'
      type: response
      require-body: true
      binary-mode: true
      max-size: -1
      timeout: 10
      engine: auto
      argument: '{"captionLang":"off","blockUpload":false,"blockImmersive":false,"blockShorts":false,"debug":false}'

script-providers:
  youtube-response-clean:
    url: https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js
    interval: 86400
